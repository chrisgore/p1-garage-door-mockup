---
import Icon from './Icon.astro';
import { REVIEWS } from '../data/reviews';
interface Props { limit?: number }
const { limit = 3 } = Astro.props;
---
<div class="revs">
  {REVIEWS.slice(0, limit).map((r) => (
    <article class="rev">
      <div class="stars" aria-label="5 out of 5 stars">{[1, 2, 3, 4, 5].map(() => <Icon name="star" size={18} />)}</div>
      <blockquote>{r.text}</blockquote>
      <footer><span>{r.who} · {r.where} · {r.service}</span><span class="tag">Sample</span></footer>
    </article>
  ))}
</div>
